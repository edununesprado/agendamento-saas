
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum MembershipRole {
  OWNER
  ADMIN
  RECEPTIONIST
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum NotificationChannel {
  EMAIL
}

enum NotificationType {
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELED
  UNCERTAIN
}

enum AppointmentAuditAction {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELED
  COMPLETED
  NO_SHOW
  UPDATED
}

enum AppointmentAuditActorType {
  USER
  PUBLIC
  SYSTEM
}

model Tenant {
  id String @id @default(cuid())

  name String
  slug String @unique

  logoUrl      String?
  primaryColor String?
  phone        String?
  email        String?

  timezone String @default("America/Sao_Paulo")

  bookingMinAdvanceMinutes Int @default(60)
  bookingMaxAdvanceDays    Int @default(7)

  appointmentRemindersEnabled    Boolean @default(true)
  appointmentReminderHoursBefore Int     @default(24)

  memberships            Membership[]
  services               Service[]
  employees              Employee[]
  clients                Client[]
  availabilityRules      AvailabilityRule[]
  blockedTimes           BlockedTime[]
  appointments           Appointment[]
  notificationDeliveries NotificationDelivery[]
  appointmentAuditLogs   AppointmentAuditLog[]

  // Etapa 6.3: logo armazenada no PostgreSQL.
  // Relacionamento opcional, uma logo por empresa.
  logoImage TenantLogo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ETAPA 6.3 — LOGO DA EMPRESA
//
// Armazenamento binário no PostgreSQL.
//
// O relacionamento 1:1 garante
// apenas uma logo por empresa.
//
// O conteúdo binário fica separado
// dos dados normalmente consultados
// na tabela Tenant.
//
// O campo Tenant.logoUrl permanece
// para compatibilidade com imagens
// previamente configuradas.

model TenantLogo {
  id String @id @default(cuid())

  tenantId String @unique

  data      Bytes @db.ByteA
  mimeType  String
  sizeBytes Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  name         String
  email        String @unique
  passwordHash String

  memberships          Membership[]
  appointmentAuditLogs AppointmentAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(cuid())

  userId   String
  tenantId String

  role MembershipRole @default(STAFF)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Service {
  id String @id @default(cuid())

  tenantId String

  name        String
  description String?

  durationMin Int
  priceCents  Int

  active Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeServices EmployeeService[]
  appointments     Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model Employee {
  id String @id @default(cuid())

  tenantId String

  name      String
  email     String?
  phone     String?
  avatarUrl String?

  active Boolean @default(true)

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String?     @unique
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  employeeServices  EmployeeService[]
  availabilityRules AvailabilityRule[]
  blockedTimes      BlockedTime[]
  appointments      Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@index([tenantId, name])
}

model EmployeeService {
  id String @id @default(cuid())

  employeeId String
  serviceId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([employeeId, serviceId])
  @@index([employeeId])
  @@index([serviceId])
}

model Client {
  id String @id @default(cuid())

  tenantId String

  name  String
  email String?
  phone String?

  birthDate DateTime?
  notes     String?

  active Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model AvailabilityRule {
  id String @id @default(cuid())

  tenantId   String
  employeeId String

  dayOfWeek   DayOfWeek
  startMinute Int
  endMinute   Int

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, dayOfWeek, startMinute, endMinute])
  @@index([tenantId, employeeId])
  @@index([employeeId, dayOfWeek])
}

model BlockedTime {
  id String @id @default(cuid())

  tenantId   String
  employeeId String

  startsAt DateTime
  endsAt   DateTime

  reason String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, employeeId])
  @@index([employeeId, startsAt])
}

model Appointment {
  id String @id @default(cuid())

  tenantId   String
  employeeId String
  serviceId  String
  clientId   String

  startsAt DateTime
  endsAt   DateTime

  durationMin Int
  priceCents  Int

  status AppointmentStatus @default(PENDING)

  notes String?

  canceledAt     DateTime?
  cancelReason   String?
  reminderSentAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  notificationDeliveries NotificationDelivery[]
  auditLogs              AppointmentAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startsAt])
  @@index([employeeId, startsAt])
  @@index([clientId, startsAt])
  @@index([tenantId, status])
  @@index([status, reminderSentAt, startsAt])
}

model NotificationDelivery {
  id String @id @default(cuid())

  tenantId      String
  appointmentId String?

  channel NotificationChannel @default(EMAIL)
  type    NotificationType
  status  NotificationStatus @default(PENDING)

  recipient String
  subject   String
  text      String
  html      String?

  dedupeKey String @unique

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  nextAttemptAt       DateTime  @default(now())
  processingStartedAt DateTime?
  lastAttemptAt       DateTime?

  sentAt   DateTime?
  failedAt DateTime?

  lastError         String?
  providerMessageId String?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([appointmentId, type])
}

model AppointmentAuditLog {
  id String @id @default(cuid())

  tenantId      String
  appointmentId String

  action    AppointmentAuditAction
  actorType AppointmentAuditActorType

  actorUserId String?
  actorName   String?
  actorRole   MembershipRole?

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorUser    User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, appointmentId, createdAt])
  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}
