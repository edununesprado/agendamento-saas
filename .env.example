# API
API_PORT=3333

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3333

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agendamento

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# SMTP / Email notifications
#
# Desenvolvimento local com Mailpit:
# SMTP_ENABLED=true
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=mailpit
# SMTP_PASS=mailpit
# SMTP_FROM_NAME=Agendamento SaaS
# SMTP_FROM_EMAIL=nao-responda@agendamento.local
#
# Em produção, substitua pelos dados
# fornecidos pelo seu provedor SMTP.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Agendamento SaaS
SMTP_FROM_EMAIL=